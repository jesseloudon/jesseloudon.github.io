---
interface Props {
  value: number;
  prefix?: string;
  suffix?: string;
  className?: string;
}

const { value, prefix = "", suffix = "", className } = Astro.props;
const formattedValue = `${prefix}${value.toLocaleString("en-AU")}${suffix}`;
---

<strong
  class={className}
  data-count-up={value}
  data-prefix={prefix}
  data-suffix={suffix}
>{formattedValue}</strong>

<script>
  const counters = document.querySelectorAll<HTMLElement>("[data-count-up]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (!reducedMotion.matches && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries, currentObserver) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting || !(entry.target instanceof HTMLElement)) {
            return;
          }

          const counter = entry.target;
          const target = Number(counter.dataset.countUp);
          const prefix = counter.dataset.prefix ?? "";
          const suffix = counter.dataset.suffix ?? "";

          if (!Number.isFinite(target)) {
            currentObserver.unobserve(counter);
            return;
          }

          currentObserver.unobserve(counter);
          let startTime: number | undefined;

          const update = (time: number) => {
            startTime ??= time;
            const progress = Math.min((time - startTime) / 1200, 1);
            const easedProgress = 1 - (1 - progress) ** 3;
            const currentValue =
              progress === 1 ? target : Math.floor(target * easedProgress);

            counter.textContent = `${prefix}${currentValue.toLocaleString("en-AU")}${suffix}`;

            if (progress < 1) {
              requestAnimationFrame(update);
            }
          };

          requestAnimationFrame(update);
        });
      },
      { threshold: 0.5 },
    );

    counters.forEach((counter) => observer.observe(counter));
  }
</script>
