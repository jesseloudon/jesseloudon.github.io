---
import { formatDate, articlePath } from '../lib/site';
const { post } = Astro.props;
const image = post.data.header?.teaser || post.data.header?.og_image;
---
<article class="post-card">
  {image && <img src={image} alt="" loading="lazy" />}
  <div>
    <p class="eyebrow">{post.data.categories?.[0] || 'Article'} · {formatDate(post.data.date)}</p>
    <h3><a href={articlePath(post)}>{post.data.title}</a></h3>
    <p class="muted">{post.data.excerpt || 'Notes, patterns, and practical lessons from the field.'}</p>
    <a class="read" href={articlePath(post)}>Read article →</a>
  </div>
</article>
<style>
.post-card{border-top:1px solid var(--line);padding:24px 0;display:grid;grid-template-columns:140px 1fr;gap:24px}.post-card img{width:140px;height:100px;object-fit:cover;border-radius:6px}.post-card h3{font:600 1.35rem 'Space Grotesk';margin:4px 0}.post-card p{margin:5px 0}.post-card .read{font-weight:700;font-size:.9rem}@media(max-width:600px){.post-card{grid-template-columns:1fr}.post-card img{width:100%;height:160px}}
</style>
