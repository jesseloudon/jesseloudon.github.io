---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { taxonomySlug } from "../../lib/site";
export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const tags = [...new Set(posts.flatMap((p) => p.data.tags || []))];
  return tags.map((tag) => ({
    params: { tag: taxonomySlug(tag) },
    props: {
      tag,
      posts: posts
        .filter((p) =>
          p.data.tags?.some((t) => taxonomySlug(t) === taxonomySlug(tag)),
        )
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}
const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`Topic: ${tag}`}
  description={`Jesse Loudon's articles and field notes about ${tag}.`}
  ><section class="wrap taxonomy">
    <p class="eyebrow">Following one thread</p><h1>#{tag}</h1><p
      class="taxonomy-intro"
    >
      These notes collect the questions, patterns and lessons connected to <strong
        >{tag}</strong
      >. Read from the latest entry or work backwards to see how the thinking
      developed.
    </p>{posts.map((post) => <PostCard post={post} />)}
  </section></BaseLayout
>
<style>
  .taxonomy {
    max-width: 820px;
    padding-top: 75px;
    padding-bottom: 80px;
  }
  .taxonomy h1 {
    font: 700 3.5rem "Space Grotesk";
    margin: 12px 0;
  }
  .taxonomy-intro {
    max-width: 700px;
    color: var(--muted);
    font-size: 1.1rem;
    margin: 0 0 35px;
  }
</style>
