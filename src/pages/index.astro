---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
const posts = (await getCollection('posts')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = posts.slice(0, 3);
---
<BaseLayout>
  <section class="hero wrap">
    <div><p class="eyebrow">Azure · DevOps · AI · Cloud governance</p><h1>Practical ideas for building <em>better cloud platforms.</em></h1><p class="intro">I'm Jesse Loudon — an architect, engineering leader, and community speaker helping organisations turn complex cloud and AI ambitions into secure, scalable delivery.</p><div class="actions"><a class="button" href="#articles">Explore the articles</a><a href="/about/">More about me →</a></div></div>
    <img src="/assets/images/jesse-profile-2024.jpg" alt="Jesse Loudon" />
  </section>
  <section class="focus wrap"><p class="eyebrow">What I write about</p><div class="focus-grid"><div><b>Policy as Code</b><p>Governance patterns that scale with your organisation.</p></div><div><b>Azure platforms</b><p>Landing zones, networking, migration, and modernisation.</p></div><div><b>DevOps & AI</b><p>Pragmatic automation and emerging engineering practices.</p></div></div></section>
  <section id="articles" class="wrap articles"><div class="section-heading"><div><p class="eyebrow">From the notebook</p><h2>Featured & latest articles</h2></div><a href="/tags/">Browse topics →</a></div><div class="featured">{featured.map((post) => <PostCard post={post} />)}</div></section>
  <section class="speaking"><div class="wrap speaking-inner"><div><p class="eyebrow">On stage</p><h2>Sharing what works</h2><p>I regularly speak about Azure Policy, secure cloud governance, DevOps, and AI-assisted engineering at community events across Australia.</p></div><a class="button" href="/speaking/">See speaking history</a></div></section>
</BaseLayout>
<style>
.hero{padding-top:90px;padding-bottom:90px;display:grid;grid-template-columns:1fr 300px;gap:80px;align-items:center}.hero h1{font:700 clamp(2.7rem,6vw,5.2rem)/1.04 'Space Grotesk';letter-spacing:-.05em;margin:15px 0 25px;max-width:760px}.hero h1 em{color:var(--accent);font-style:normal}.intro{font-size:1.2rem;max-width:680px;color:var(--muted)}.hero img{width:300px;height:300px;object-fit:cover;border-radius:50%;border:12px solid var(--warm)}.actions{display:flex;align-items:center;gap:22px;margin-top:30px}.focus{padding:55px 24px}.focus-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.focus-grid div{padding:22px;border:1px solid var(--line);border-radius:8px}.focus-grid b{font:600 1.2rem 'Space Grotesk'}.focus-grid p{margin-bottom:0;color:var(--muted)}.articles{padding-top:55px}.section-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:15px}.section-heading h2,.speaking h2{font:600 2.2rem 'Space Grotesk';margin:5px 0 15px}.speaking{background:var(--warm);margin-top:80px}.speaking-inner{padding-top:55px;padding-bottom:55px;display:flex;justify-content:space-between;gap:30px;align-items:center}.speaking-inner p:not(.eyebrow){max-width:650px;color:var(--muted)}@media(max-width:700px){.hero{display:block;padding-top:55px}.hero img{width:180px;height:180px;margin-top:40px}.focus-grid{grid-template-columns:1fr}.section-heading,.speaking-inner{display:block}.speaking-inner .button{margin-top:15px}}
</style>
