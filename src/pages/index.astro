---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featured = posts.slice(0, 3);
---

<BaseLayout>
  <section class="hero wrap">
    <div>
      <p class="eyebrow">
        Principal consultant · Cloud strategist · Trusted adviser
      </p><h1>
        Turning complex technology ambition into <em>confidence and action.</em>
      </h1><p class="intro">
        I'm Jesse Loudon. I help leaders shape, sell and deliver secure Azure,
        DevOps and AI transformation programs, bringing architecture, commercial
        thinking and people leadership into the same conversation.
      </p><div class="actions">
        <a class="button" href="/about/#how-i-help">How I help</a><a
          href="https://www.linkedin.com/in/jesseloudon/">Connect on LinkedIn</a
        >
      </div>
    </div>
    <div class="hero-portrait">
      <img src="/assets/images/global-azure-2024.jpg" alt="Jesse Loudon" />
    </div>
  </section>
  <section class="proof wrap" aria-label="Career highlights">
    <div>
      <strong>15+</strong><span
        >years in client-facing<br />consulting roles</span
      >
    </div><div>
      <strong>$3M+</strong><span
        >presales opportunity<br />led for one program</span
      >
    </div><div>
      <strong>40+</strong><span
        >consultants influenced<br />through practice leadership</span
      >
    </div><div>
      <strong>2x</strong><span>Microsoft Azure MVP<br />recognition</span>
    </div>
  </section>
  <section class="positioning wrap">
    <div>
      <p class="eyebrow">The value I bring</p><h2>
        Technical depth that earns trust. Human skills that move decisions.
      </h2>
    </div><div class="positioning-copy">
      <p>
        My strongest work happens before and beyond implementation: listening
        for the real problem, making complexity legible to decision-makers,
        creating a credible path forward, and helping teams feel ownership of
        the change.
      </p><p>
        That means I can move comfortably between a C-suite conversation, an
        architecture review, a proposal workshop and a delivery team that needs
        practical enablement.
      </p>
    </div>
  </section>
  <section class="focus wrap">
    <p class="eyebrow">What I write about</p><div class="focus-grid">
      <div>
        <b>Policy as Code</b><p>
          Governance patterns that scale with your organisation.
        </p>
      </div><div>
        <b>Azure platforms</b><p>
          Landing zones, networking, migration, and modernisation.
        </p>
      </div><div>
        <b>DevOps & AI</b><p>
          Pragmatic automation and emerging engineering practices.
        </p>
      </div>
    </div>
  </section>
  <section id="articles" class="wrap articles">
    <div class="section-heading">
      <div>
        <p class="eyebrow">From the notebook</p><h2>
          Featured & latest articles
        </h2>
      </div><a href="/tags/">Browse topics →</a>
    </div><div class="featured">
      {featured.map((post) => <PostCard post={post} />)}
    </div>
  </section>
  <section class="speaking">
    <div class="wrap speaking-inner">
      <div>
        <p class="eyebrow">On stage and in the community</p><h2>
          Making the next step easier to take
        </h2><p>
          Through talks, writing, open source and mentoring, I translate
          emerging technology into useful decisions and repeatable practice.
        </p>
      </div><a class="button" href="/speaking/">See speaking history</a>
    </div>
  </section>
</BaseLayout>
<style>
  .hero {
    padding-top: 90px;
    padding-bottom: 75px;
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 80px;
    align-items: center;
  }
  .hero h1 {
    font: 700 clamp(2.7rem, 6vw, 5.2rem)/1.04 "Space Grotesk";
    letter-spacing: -0.05em;
    margin: 15px 0 25px;
    max-width: 760px;
  }
  .hero h1 em {
    color: var(--accent);
    font-style: normal;
  }
  .intro {
    font-size: 1.2rem;
    max-width: 680px;
    color: var(--muted);
  }
  .hero-portrait {
    width: 300px;
    height: 300px;
    overflow: hidden;
    border: 12px solid var(--warm);
    border-radius: 50%;
  }
  .hero-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.25);
    transform-origin: 50% 40%;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 30px;
  }
  .proof {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-top: 28px;
    padding-bottom: 28px;
  }
  .proof div {
    display: flex;
    gap: 12px;
    align-items: center;
    border-right: 1px solid var(--line);
  }
  .proof div:last-child {
    border: 0;
  }
  .proof strong {
    font: 700 1.9rem "Space Grotesk";
    color: var(--accent);
  }
  .proof span {
    font-size: 0.8rem;
    line-height: 1.3;
    color: var(--muted);
  }
  .positioning {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 80px;
    padding-top: 95px;
    padding-bottom: 45px;
  }
  .positioning h2 {
    font: 600 clamp(2rem, 4vw, 3.3rem)/1.05 "Space Grotesk";
    letter-spacing: -0.05em;
    margin: 12px 0;
  }
  .positioning-copy {
    font-size: 1.08rem;
    color: var(--muted);
  }
  .focus {
    padding: 55px 24px;
  }
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .focus-grid div {
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .focus-grid b {
    font: 600 1.2rem "Space Grotesk";
  }
  .focus-grid p {
    margin-bottom: 0;
    color: var(--muted);
  }
  .articles {
    padding-top: 55px;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 15px;
  }
  .section-heading h2,
  .speaking h2 {
    font: 600 2.2rem "Space Grotesk";
    margin: 5px 0 15px;
  }
  .speaking {
    background: var(--warm);
    margin-top: 80px;
  }
  .speaking-inner {
    padding-top: 55px;
    padding-bottom: 55px;
    display: flex;
    justify-content: space-between;
    gap: 30px;
    align-items: center;
  }
  .speaking-inner p:not(.eyebrow) {
    max-width: 650px;
    color: var(--muted);
  }
  @media (max-width: 800px) {
    .proof {
      grid-template-columns: repeat(2, 1fr);
    }
    .proof div:nth-child(2) {
      border: 0;
    }
  }
  @media (max-width: 700px) {
    .hero {
      display: block;
      padding-top: 55px;
    }
    .hero-portrait {
      margin-top: 40px;
      width: 180px;
      height: 180px;
    }
    .positioning {
      display: block;
      padding-top: 70px;
    }
    .positioning-copy {
      margin-top: 30px;
    }
    .focus-grid {
      grid-template-columns: 1fr;
    }
    .section-heading,
    .speaking-inner {
      display: block;
    }
    .speaking-inner .button {
      margin-top: 15px;
    }
  }
  @media (max-width: 500px) {
    .proof {
      display: block;
    }
    .proof div {
      border: 0;
      border-bottom: 1px solid var(--line);
      padding: 12px 0;
    }
    .proof div:last-child {
      border: 0;
    }
  }
</style>
