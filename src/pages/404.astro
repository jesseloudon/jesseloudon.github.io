---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found"><section class="wrap not-found"><p class="eyebrow">404 · A dead end</p><h1>This page is no longer part of the story.</h1><p>The link may be old, or the page may have moved while the site changed. Start with the current profile, then follow the articles and talks from there.</p><div class="not-found-actions"><a class="button" href="/">Start at the homepage</a><a href="/about/">Read the profile</a></div></section></BaseLayout>
<style>.not-found{padding:120px 24px;text-align:center;max-width:760px}.not-found h1{font:700 clamp(2.5rem,6vw,3.5rem)/1.05 'Space Grotesk';margin:12px 0 20px}.not-found p:not(.eyebrow){color:var(--muted);font-size:1.1rem}.not-found-actions{display:flex;justify-content:center;align-items:center;gap:22px;margin-top:28px}@media(max-width:500px){.not-found-actions{display:block}.not-found-actions a{display:inline-block;margin-top:12px}}</style>
