---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found"><section class="wrap not-found"><p class="eyebrow">404</p><h1>That page wandered off.</h1><p>The link may be old, or the page may have moved. Try the homepage or browse the articles.</p><a class="button" href="/">Back home</a></section></BaseLayout>
<style>.not-found{padding:120px 24px;text-align:center}.not-found h1{font:700 3.5rem 'Space Grotesk'}</style>
