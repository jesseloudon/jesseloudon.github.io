---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, slugFor, taxonomySlug } from '../lib/site';
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: `${taxonomySlug(post.data.categories?.[0] || 'blog')}/${slugFor(post)}` }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <article class="wrap article">
    <p class="eyebrow">{post.data.categories?.[0] || 'Article'} · {formatDate(post.data.date)}</p>
    <h1>{post.data.title}</h1>
    {post.data.excerpt && <p class="dek">{post.data.excerpt}</p>}
    <div class="article-content"><Content /></div>
    <footer class="article-footer"><a href="/#articles">← Back to articles</a>{post.data.tags?.map((tag) => <a href={`/tags/${taxonomySlug(tag)}/`}>#{tag}</a>)}</footer>
  </article>
</BaseLayout>
<style>.article{max-width:820px;padding-top:75px}.article h1{font:700 clamp(2.5rem,6vw,4.4rem)/1.08 'Space Grotesk';letter-spacing:-.045em;margin:12px 0 20px}.dek{font-size:1.3rem;color:var(--muted);border-bottom:1px solid var(--line);padding-bottom:35px}.article-content{padding-top:30px}.article-footer{border-top:1px solid var(--line);margin-top:65px;padding:22px 0;display:flex;gap:22px;flex-wrap:wrap;font-weight:700}</style>
