---
import BaseLayout from '../layouts/BaseLayout.astro';

const talks = [
  {
    year: '2026',
    event: 'Global Azure',
    venue: 'Melbourne Azure Nights',
    title: 'Policy as Code with Microsoft Foundry Agents',
    description: 'How specialised AI agents can automate post-deployment testing and reporting in a Policy-as-Code flow.',
    links: [
      ['Watch the session', 'https://lnkd.in/gJ-2z-_q']
    ],
    featured: true
  },
  {
    year: '2024',
    event: 'Global Azure',
    venue: 'Microsoft Reactor Sydney',
    title: 'GitHub Copilot on Azure Policies',
    description: 'A practical look at where an AI assistant can help with Azure Policy development, from authoring through live demonstrations and Q&A.',
    links: [
      ['Watch the session', 'https://youtu.be/_Fjs7kUGeLI?si=1pn20ZZJsR0WV0rG']
    ]
  },
  {
    year: '2022',
    event: 'Microsoft Reactor Sydney',
    venue: 'Sydney, Australia',
    title: 'Authoring Custom Azure Policy Definitions',
    description: 'A hands-on session covering custom policy structure, live authoring and the practical decisions behind maintainable definitions.',
    links: [
      ['Watch', 'https://youtu.be/qygOCyambK4'],
      ['Slides', '/assets/pdfs/MR2022-AuthoringCustomAzurePolicyDefinitions.pdf'],
      ['Read more', 'https://learn.microsoft.com/en-us/azure/governance/policy/concepts/definition-structure?WT.mc_id=AZ-MVP-5004598']
    ]
  },
  {
    year: '2022',
    event: 'Microsoft Reactor Sydney',
    venue: 'Sydney, Australia',
    title: 'Flexing Your Security Governance with Azure Policy as Code',
    description: 'Using Azure Bicep to build a security-focused Policy-as-Code approach that scales beyond a single subscription.',
    links: [
      ['Watch', 'https://youtu.be/SuH_TBBsvLI'],
      ['Slides', '/assets/pdfs/MR2022-FlexingYourSecurityGovernanceWithAzurePolicyAsCode.pdf'],
      ['Read the companion article', '/cloud/flexing-your-security-governance-with-azure-policy-as-code/']
    ]
  },
  {
    year: '2021',
    event: 'Ctrl+Alt+Azure',
    venue: 'Podcast episode 109',
    title: 'Managing Azure Policy as Code with Bicep',
    description: 'A conversation about the practical patterns, tradeoffs and lessons learned from managing Azure governance as code.',
    links: [
      ['Listen to the episode', 'https://ctrlaltazure.com/episodes/109-azure-policy-as-code'],
      ['Read the companion article', '/cloud/talking-azure-policy-as-code-on-the-ctrlaltazure-podcast/']
    ]
  },
  {
    year: '2021',
    event: 'Melbourne Azure Security',
    venue: 'Community Meetup',
    title: 'Flexing Your Security Governance with Azure Policy as Code',
    description: 'A security-focused Azure Bicep session with live demonstrations and practical governance patterns.',
    links: [
      ['Watch', 'https://youtu.be/-KSLh2I9e1U'],
      ['Slides', '/assets/pdfs/MelbAzureSecMeetup2021_FlexingYourSecurityGovernanceWithAzurePolicyAsCode.pdf']
    ]
  },
  {
    year: '2021',
    event: 'DevOps Sydney',
    venue: 'Community Meetup',
    title: 'Automate Infrastructure Governance with Azure Policy',
    description: 'Applying Terraform and Policy as Code to make infrastructure governance repeatable and auditable.',
    links: [
      ['Watch', 'https://youtu.be/dPwy8nlNyNM?t=570'],
      ['Slides', '/assets/pdfs/SydDevOps2021_AutomateInfraGovWithAzPolicy.pdf']
    ]
  },
  {
    year: '2021',
    event: 'Azure Sydney User Group',
    venue: 'Community Meetup',
    title: 'Azure Policy as Code: Zero to Hero in 60 Minutes',
    description: 'A practical introduction to the building blocks of Azure Policy as Code with Bicep.',
    links: [
      ['Watch', 'https://youtu.be/AVn5glYBz84?t=2380'],
      ['Slides', '/assets/pdfs/AzureSydUserGroup2021_PolicyAsCode_ZeroToHero60min.pdf']
    ]
  },
  {
    year: '2021',
    event: 'Global Azure',
    venue: 'Online community event',
    title: 'Policy as Code with Bicep for Enterprise Scale',
    description: 'Designing a Policy-as-Code approach for consistent governance across an enterprise Azure estate.',
    links: [
      ['Watch', 'https://youtu.be/qpnMJXw6pIg'],
      ['Slides', '/assets/pdfs/GlobalAzure2021_PolicyAsCodeWithBicepForEnterpriseScale.pdf'],
      ['Read the companion article', '/cloud/global-azure-policy-as-code-with-bicep-for-enterprise-scale/']
    ]
  },
  {
    year: '2021',
    event: 'HashiTalks ANZ',
    venue: 'HashiCorp community event',
    title: 'DRY Coding with Terraform, CSVs and for_each',
    description: 'Using Terraform data structures and for_each to create simpler, reusable infrastructure code.',
    links: [
      ['Watch', 'https://youtu.be/aARIovQQSJ4'],
      ['Slides', '/assets/pdfs/DRY_CodingwithTerraformCSVsForEach.pdf'],
      ['Read the companion article', '/cloud/hashitalks-anz-dry-coding-with-terraform-csvs-foreach/']
    ]
  }
];

const themes = [
  ['01', 'Cloud governance', 'Policy as Code, security guardrails and operating models that help teams move quickly with confidence.'],
  ['02', 'Azure platforms', 'Landing zones, enterprise networking, migration and modernisation patterns grounded in delivery experience.'],
  ['03', 'AI-assisted engineering', 'Practical ways to apply agents and copilots to development, testing and platform operations.']
];
---

<BaseLayout title="Speaking" description="Jesse Loudon speaks about Azure, cloud governance, Policy as Code, DevOps and AI-assisted engineering.">
  <section class="speaker-hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Speaker · Architect · Community advocate</p>
        <h1>Ideas worth sharing.<br /><span>Patterns worth taking home.</span></h1>
        <p class="hero-copy">I speak about the practical side of cloud and AI transformation: how to build platforms that are secure, governed and useful to the teams who operate them.</p>
        <div class="hero-actions">
          <a class="button" href="https://sessionize.com/JesseLoudon/">Invite me to speak</a>
          <a class="text-link" href="#talks">Explore the talks <span>↓</span></a>
        </div>
      </div>
      <div class="speaker-portrait" aria-label="Jesse Loudon speaking at a technology event">
        <div class="portrait-frame">
          <img src="/assets/images/speaking-hackathon-2026.jpg" alt="Jesse Loudon presenting at a technology event" />
          <div class="portrait-wash"></div>
          <div class="portrait-caption">
            <span>JESSE LOUDON</span>
          </div>
          <div class="portrait-tag">SPEAKER</div>
        </div>
        <div class="portrait-orbit orbit-one"></div>
        <div class="portrait-orbit orbit-two"></div>
      </div>
    </div>
  </section>

  <section class="proof wrap" aria-label="Speaking highlights">
    <div><strong>10+</strong><span>community talks<br />and appearances</span></div>
    <div><strong>2021-23</strong><span>Microsoft Azure<br />MVP recognition</span></div>
    <div><strong>Australia</strong><span>meetups, events<br />and podcasts</span></div>
  </section>

  <section class="wrap themes">
    <div class="section-intro">
      <p class="eyebrow">What I bring to the room</p>
      <h2>Practical expertise, not platform theatre.</h2>
    </div>
    <div class="theme-grid">
      {themes.map(([number, title, description]) => (
        <article>
          <span class="theme-number">{number}</span>
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="talks" class="talks">
    <div class="wrap">
      <div class="section-intro talks-intro">
        <p class="eyebrow">Selected appearances</p>
        <h2>From the stage, the stream and the studio.</h2>
        <p>Browse talks, interviews and community sessions. Where available, recordings and slides are included so the ideas can keep travelling after the event.</p>
      </div>
      <div class="talk-list">
        {talks.map((talk) => (
          <article class:list={['talk-card', { featured: talk.featured }]}>
            <div class="talk-year">{talk.year}</div>
            <div class="talk-body">
              <p class="talk-event">{talk.event} <span>/</span> {talk.venue}</p>
              <h3>{talk.title}</h3>
              <p>{talk.description}</p>
              <div class="talk-links">
                {talk.links.map(([label, url]) => <a href={url}>{label} <span>↗</span></a>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="speaker-cta">
    <div class="wrap cta-inner">
      <div>
        <p class="eyebrow">Planning an event?</p>
        <h2>Let's make the session useful.</h2>
        <p>For speaking enquiries, session topics or community collaborations, connect with me through Sessionize or LinkedIn.</p>
      </div>
      <div class="cta-actions">
        <a class="button" href="https://sessionize.com/JesseLoudon/">Sessionize profile</a>
        <a class="button button-light" href="https://www.linkedin.com/in/jesseloudon/">Connect on LinkedIn</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .speaker-hero{background:var(--ink);color:#fff;overflow:hidden}.hero-grid{min-height:560px;display:grid;grid-template-columns:1.3fr .7fr;align-items:center;gap:60px}.speaker-hero .eyebrow{color:#66c7f4}.speaker-hero h1{font:700 clamp(3rem,7vw,6.5rem)/.96 'Space Grotesk';letter-spacing:-.07em;margin:18px 0 30px}.speaker-hero h1 span{color:#66c7f4}.hero-copy{max-width:620px;color:#c3d0db;font-size:1.2rem}.hero-actions{display:flex;gap:25px;align-items:center;margin-top:34px}.text-link{color:#fff;font-weight:700}.text-link span{color:#66c7f4;font-size:1.3rem;margin-left:5px}.speaker-portrait{justify-self:end;width:360px;height:410px;position:relative}.portrait-frame{position:absolute;inset:20px 25px 20px 5px;overflow:hidden;border:1px solid #66c7f4;background:#0f2634;transform:rotate(4deg);box-shadow:20px 20px 0 rgba(102,199,244,.18)}.portrait-frame img{width:100%;height:100%;object-fit:cover;object-position:center top;filter:grayscale(20%) contrast(1.05)}.portrait-wash{position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,23,33,.05) 35%,rgba(7,23,33,.92) 100%)}.portrait-caption{position:absolute;left:24px;bottom:22px}.portrait-caption span{font:700 .72rem 'Space Grotesk';letter-spacing:.15em;color:#c3eafa}.portrait-tag{position:absolute;top:20px;left:18px;background:#66c7f4;color:var(--ink);padding:7px 10px;font:700 .7rem 'Space Grotesk';letter-spacing:.12em;transform:rotate(-4deg)}.portrait-orbit{position:absolute;border:1px solid #426072;border-radius:50%;pointer-events:none}.orbit-one{width:410px;height:150px;top:126px;left:-25px;transform:rotate(-28deg)}.orbit-two{width:310px;height:110px;top:165px;left:40px;transform:rotate(55deg);border-color:#285166}.proof{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid var(--line);padding-top:30px;padding-bottom:30px;gap:20px}.proof div{display:flex;gap:16px;align-items:center;border-right:1px solid var(--line)}.proof div:last-child{border:0}.proof strong{font:700 2rem 'Space Grotesk';color:var(--accent)}.proof span{font-size:.85rem;line-height:1.35;color:var(--muted)}.themes{padding-top:100px;padding-bottom:105px;display:grid;grid-template-columns:.75fr 1.25fr;gap:75px}.section-intro h2,.talks-intro h2{font:600 clamp(2rem,4vw,3.2rem)/1.05 'Space Grotesk';letter-spacing:-.05em;margin:12px 0 20px}.theme-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.theme-grid article{border-top:3px solid var(--accent);padding-top:18px}.theme-number{font:700 .8rem 'Space Grotesk';color:var(--accent)}.theme-grid h3{font:600 1.2rem 'Space Grotesk';margin:30px 0 8px}.theme-grid p{font-size:.95rem;color:var(--muted);margin:0}.talks{background:#f2f8fb;padding:100px 0}.talks-intro{max-width:700px}.talks-intro>p:last-child{color:var(--muted);max-width:620px}.talk-list{margin-top:50px;border-top:1px solid #cbdde6}.talk-card{display:grid;grid-template-columns:100px 1fr;gap:35px;border-bottom:1px solid #cbdde6;padding:35px 0}.talk-card.featured{border-left:5px solid var(--accent);padding-left:25px;background:linear-gradient(90deg,rgba(0,120,212,.08),transparent);margin-left:-25px;margin-right:-25px;padding-right:25px}.talk-year{font:700 1.2rem 'Space Grotesk';color:var(--accent)}.talk-event{font:700 .78rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin:0 0 12px}.talk-event span{color:#a7bcc8;padding:0 6px}.talk-body h3{font:600 clamp(1.4rem,3vw,2.1rem)/1.1 'Space Grotesk';margin:0 0 12px}.talk-body>p:not(.talk-event){max-width:700px;color:var(--muted);margin:0}.talk-links{display:flex;flex-wrap:wrap;gap:18px;margin-top:20px}.talk-links a{font-size:.9rem;font-weight:700}.talk-links span{font-size:1rem}.speaker-cta{background:var(--accent);color:#fff}.cta-inner{padding-top:70px;padding-bottom:70px;display:flex;justify-content:space-between;align-items:center;gap:40px}.speaker-cta .eyebrow{color:#c9edff}.speaker-cta h2{font:600 2.7rem/1 'Space Grotesk';margin:12px 0}.speaker-cta p:not(.eyebrow){color:#d7effb;max-width:580px}.cta-actions{display:flex;flex-wrap:wrap;gap:12px}.button-light{background:#fff;color:var(--accent)}.button-light:hover{background:#e7f6fd;color:var(--accent)}
  @media(max-width:800px){.hero-grid{min-height:0;padding-top:75px;padding-bottom:75px;display:block}.speaker-portrait{width:300px;height:350px;margin:60px auto 0}.themes{display:block;padding-top:75px;padding-bottom:75px}.theme-grid{margin-top:40px}.cta-inner{display:block}.cta-actions{margin-top:25px}}
  @media(max-width:600px){.hero-actions{display:block}.hero-actions .text-link{display:inline-block;margin-top:20px}.proof{display:block}.proof div{border-right:0;border-bottom:1px solid var(--line);padding:15px 0}.proof div:last-child{border-bottom:0}.theme-grid{display:block}.theme-grid article{margin-top:30px}.talks{padding:70px 0}.talk-card{display:block}.talk-year{margin-bottom:15px}.talk-card.featured{margin-left:-10px;margin-right:-10px;padding-left:15px;padding-right:15px}.speaker-cta h2{font-size:2.2rem}}
</style>
